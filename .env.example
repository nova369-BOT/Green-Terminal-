# Green Terminal — local environment template.
#
#   cp .env.example .env     then fill in your own values
#
# `.env` is gitignored and must stay that way. Never commit real credentials:
# anything committed to git lives in the history permanently, survives a
# force-push in clones and forks, and cannot be truly deleted.
#
# docker compose reads `.env` from this directory automatically.
# On Render, set these in the dashboard under Environment instead.

# ── cTrader Open API ────────────────────────────────────────────────────────
# From https://openapi.ctrader.com/apps — your application's Credentials view.
# These identify GREEN TERMINAL AS AN APPLICATION, registered once by you.
# They are NOT per-user: your users sign in on cTrader's own page and never
# see these values.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=

# "demo" or "live". Anything unrecognised falls back to demo, so you cannot
# point at real money by accident.
#   demo -> demo.ctraderapi.com:5035
#   live -> live.ctraderapi.com:5035
CTRADER_ENV=demo

# ── Sandbox / Playground token (development, before approval) ───────────────
# While your application still shows "Submitted", open it in the portal and
# press Sandbox (Playground) -> choose scope -> Get token. Paste the access
# token here and Green Terminal will use it directly, skipping the consent
# flow, so you can build against real broker data before Spotware approves.
#
# This authorises YOUR OWN accounts only, so it cannot serve other users.
# Once the app is Active, delete these two lines and the normal per-user
# Connect button takes over - no code change.
# CTRADER_ACCESS_TOKEN=
# CTRADER_ACCOUNT_ID=

# ── Reminder: redirect URIs ─────────────────────────────────────────────────
# Every URL you actually use must be listed on the Open API application, and
# must match EXACTLY — "localhost" and "127.0.0.1" count as different strings,
# so register both if you use both.
#
#   http://localhost:7787/api/ctrader/callback
#   http://127.0.0.1:7787/api/ctrader/callback
#   https://green-terminal.onrender.com/api/ctrader/callback
#
# The greyed-out default redirect URL in the portal is playground-only and
# will not work from code.
